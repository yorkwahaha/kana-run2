static func set_locale(loc: String) -> void:
	if LOCALES.has(loc):
		current_locale = loc
	else:
		current_locale = "zh_TW"

static func cycle_locale() -> String:
	var idx := LOCALES.find(current_locale)
	var next_idx := (idx + 1) % LOCALES.size()
	current_locale = LOCALES[next_idx]
	return current_locale

