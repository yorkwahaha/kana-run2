static func t(key: String, default_text := "") -> String:
	var extra: Dictionary = PACK.get(current_locale, {})
	if extra.has(key):
		return str(extra[key])
	var dict: Dictionary = STRINGS.get(current_locale, STRINGS["zh_TW"])
	if dict.has(key):
		return str(dict[key])
	var fallback: Dictionary = STRINGS["zh_TW"]
	if fallback.has(key):
		return str(fallback[key])
	return default_text if default_text != "" else key

static func knowledge(id: String, fallback: String) -> String:
	return t("KNOW_" + id, fallback)
